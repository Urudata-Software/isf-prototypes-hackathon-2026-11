# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/
next-env.d.ts

# Next.js generates these from the routes that exist; committing them makes a
# template ship a validator that references pages a POC has since deleted.
web/types/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real values never, examples always
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# python
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# local prototype database
*.db
*.db-journal
*.db-wal

# agent browser-debug output
.playwright-cli/

# Claves locales de la demo Lote360
config.js
.vs/
dist/

.env*
