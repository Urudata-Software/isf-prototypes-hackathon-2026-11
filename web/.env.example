# Copy this to .env.local and change nothing. It works as-is for a prototype.
#
#   cp .env.example .env.local

BACKEND_API_URL=http://localhost:8000


# ─────────────────────────────────────────────────────────────────────────────
# Microsoft Entra ID — leave all of these empty for a prototype.
#
# Empty: the app runs as a demo user and never asks anyone to sign in.
# Filled in: real sign-in takes over. No code changes either way — the provider
# is already wired in src/lib/auth.ts, including token refresh.
#
# Set all four or none of them; half-configured auth fails at boot on purpose.
# Generate AUTH_SECRET with: npx auth secret
# ENTRA_TENANT_ID is the tenant GUID (or "organizations" for any work account).
#
# Full Azure steps: STACK.md -> Turning on Entra ID
# ─────────────────────────────────────────────────────────────────────────────
AUTH_SECRET=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Only needed if api/ should verify tokens too. This is the scope you exposed
# under "Expose an API" on the app registration, e.g.
#   api://00000000-0000-0000-0000-000000000000/access_as_user
#
# Without it Entra issues a Microsoft Graph token, which api/ cannot verify — so
# leave it empty to protect the UI only, and leave api/.env's ENTRA_* empty too.
ENTRA_API_SCOPE=

# Canonical URL of this app, used to build the sign-in callback URL.
# Only matters once auth is configured.
AUTH_URL=http://localhost:3000
