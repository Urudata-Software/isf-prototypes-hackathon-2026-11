# Copy this to .env and change nothing. It works as-is for a prototype.
#
#   cp .env.example .env

# SQLite needs no server and no setup. Production is PostgreSQL or SQL Server —
# because migrations are in place from the first commit, that swap is this one
# line and nothing else:
#   postgresql+psycopg://user:password@host/dbname
#   mssql+pyodbc://user:password@host/dbname?driver=ODBC+Driver+18+for+SQL+Server
DATABASE_URL=sqlite:///./prototype.db


# ─────────────────────────────────────────────────────────────────────────────
# Credentials. Every one of these is optional, and each one decides which
# implementation binds at runtime — see app/dependencies.py.
#
# Empty: a fake stands in and the whole app runs on this laptop.
# Filled in: the real thing takes over. No code changes either way.
#
# A marketing user will not have any of these. Leaving them empty is the
# expected state, not a broken one.
# ─────────────────────────────────────────────────────────────────────────────

# Calling a language model. Empty -> FakeLlmClient returns canned text.
OPENAI_API_KEY=

# Which model the real client uses. Change here rather than in code.
OPENAI_MODEL=gpt-4o-mini

# Microsoft Entra ID. Empty -> requests are not authenticated at all, which is
# correct for a prototype that only ever talks to its own frontend.
#
# Set both to require and verify a bearer token on every request. The tenant must
# match the web app's ENTRA_TENANT_ID, and the audience must be what the token is
# addressed to — the Application ID URI you set under "Expose an API"
# (api://<client-id>), or the client id itself.
#
# See STACK.md -> Turning on Entra ID for the Azure steps.
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
